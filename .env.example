# Copy to .env and fill in (never commit .env)

# LinkedIn credentials (browser login)
LINKEDIN_EMAIL=
LINKEDIN_PASSWORD=

# Optional: persistent browser profile directory (relative to project root)
BROWSER_USER_DATA_DIR=storage/browser-profile

# Run headless (true/false)
HEADLESS=false

# Rate limiting — seconds between actions (be conservative)
ACTION_DELAY_SECONDS=3
